# ---- Frontend (Vercel project env vars; server-side only, never NEXT_PUBLIC_) ----
BACKEND_API_URL=https://your-backend.example.com
BACKEND_API_KEY=long-random-shared-secret

# ---- Backend (EthioDeploy env vars) ----
BACKEND_API_KEY=long-random-shared-secret      # must equal the frontend value
DATABASE_URL=                                  # postgresql://user:pass@host:5432/db (REQUIRED in production for persistence)
DATABASE_PATH=lead_finder.db                   # SQLite fallback for local/demo only
APIFY_API_TOKEN=                               # enables live discovery
APIFY_ACTOR_ID=compass/crawler-google-places
ADMIN_EMAILS=                                  # comma-separated; first registered user is admin regardless
ENVIRONMENT=production                        # production refuses to start without BACKEND_API_KEY
ABUSE_CONTACT=                                 # email or URL shown in the crawler User-Agent
ALLOW_REGISTRATION=true                        # set false after your team has registered
ALLOWED_ORIGINS=                               # optional
RATE_LIMIT_PER_MIN=240
JOB_WORKERS=2
INSPECT_WORKERS=8
PAGE_DELAY_SECS=2.0
PER_QUERY_LIMIT=20
COST_PER_CANDIDATE=0.002
ROBOTS_ENABLED=true
